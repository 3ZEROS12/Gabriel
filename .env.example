# Gabriel Security Configuration
# Copy this file to .env and set your custom values.
#
# GABRIEL_TOKEN: leave EMPTY to auto-generate a fresh random token on every
# startup (token is printed in the terminal). Set a strong random value only
# if you need the same token across restarts:
#   python -c "import secrets; print(secrets.token_hex(16))"
# IMPORTANT: never leave a placeholder string here — it would become your
# real auth token. If you already copied this file, delete the placeholder.
GABRIEL_TOKEN=

# LLM API key (OpenAI-compatible). Kept ONLY in the environment so it is never
# persisted to config.json. (Preferred over storing it in the Settings UI.)
# e.g. DeepSeek / OpenAI / any OpenAI-compatible endpoint.
OPENAI_API_KEY=your_api_key_here
